# ========================================================
# PETAL & PROMISE - FRONTEND CLIENT ENVIRONMENT VARIABLES
# ========================================================

# Firebase Web App Client Configuration
# (Found in Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Admin Email Identification
VITE_ADMIN_EMAIL=admin@petalandpromise.com

# Backend API URL (leave empty in local dev to use Vite proxy, or set Render backend URL for production)
VITE_API_URL=https://petal-and-promise-api.onrender.com

