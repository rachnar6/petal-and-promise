# ========================================================
# PETAL & PROMISE - BACKEND ENVIRONMENT VARIABLES
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Admin Security
ADMIN_EMAIL=admin@petalandpromise.com
ADMIN_SECRET_KEY=petal-secret-admin-2026

# Database: MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/petal_and_promise?retryWrites=true&w=majority
MONGODB_URI=

# Firebase Authentication Admin SDK
# Option A: Path to serviceAccountKey.json downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
# Option B: Or copy-paste the whole JSON content in one line as a string
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Pabbly Connect Webhook Automation URLs
# (You can use one main webhook or separate webhooks per workflow)
PABBLY_WEBHOOK_URL=
PABBLY_WEBHOOK_BOOKING_CREATED=
PABBLY_WEBHOOK_CONSULTATION_SCHEDULED=
PABBLY_WEBHOOK_STATUS_UPDATED=
PABBLY_WEBHOOK_ENQUIRY_CREATED=
